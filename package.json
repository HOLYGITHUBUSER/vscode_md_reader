{
  "name": "md-editor",
  "displayName": "MD Editor",
  "description": "Markdown 所见即所得编辑器：可在预览页直接编辑并回写 Markdown",
  "version": "0.1.0",
  "publisher": "md-editor",
  "license": "MIT",
  "icon": "00-config-工程配置/icon-扩展图标.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HOLYGITHUBUSER/vscode_md_reader.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onCustomEditor:md-editor.editor",
    "onCommand:md-editor.openPreview",
    "onCommand:md-editor.toggleView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "md-editor.editor",
        "displayName": "MD Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "md-editor.openPreview",
        "title": "MD Editor: 打开阅读器"
      },
      {
        "command": "md-editor.toggleView",
        "title": "MD Editor: 切换源码/预览"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "MD Editor 配置",
      "properties": {
        "md-editor.defaultView": {
          "type": "string",
          "enum": [
            "preview",
            "source"
          ],
          "default": "preview",
          "description": "打开阅读器时的默认标签：预览（默认）或源码"
        },
        "md-editor.autoOpenReader": {
          "type": "boolean",
          "default": true,
          "description": "为 true 时把 *.md/*.markdown 关联到 MD Editor，并用阅读器打开文本标签；改为 false 时清除本扩展写入的关联"
        },
        "md-editor.mermaidTheme": {
          "type": "string",
          "enum": [
            "auto",
            "cursor",
            "dark",
            "default",
            "light",
            "neutral",
            "forest",
            "base"
          ],
          "default": "auto",
          "description": "Mermaid 风格：auto/cursor/dark=Cursor 暗色简洁灰；default/light=浅色简洁；neutral/forest/base=官方皮肤"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./00-config-工程配置/tsconfig-编译配置.json",
    "vscode:prepublish": "npm run compile",
    "package:force": "python3 03-script-构建脚本/build-编译打包.py",
    "package": "python3 03-script-构建脚本/build-编译打包.py --bump",
    "lint": "eslint '01-extension-扩展逻辑/**/*.ts'",
    "test": "npm run compile && node --test \"out/test-单元测试/**/*.test.js\"",
    "test:e2e": "playwright test --config 05-e2e-浏览器测试/playwright-配置.ts",
    "test:full": "npm test && npm run test:e2e && npm run package:force"
  },
  "dependencies": {
    "markdown-it": "^14.0.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/jsdom": "^28.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.70.0",
    "@vscode/vsce": "^2.15.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0"
  }
}
